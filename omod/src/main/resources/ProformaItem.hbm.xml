<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
 "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.openmrs.module.mohbilling.model">

	<class name="ProformaItem" table="moh_bill_proforma_item">

		<id name="proformaItemId" type="int" column="proforma_item_id" unsaved-value="0">
			<generator class="native" />
		</id>

		<many-to-one name="proforma" class="org.openmrs.module.mohbilling.model.Proforma" column="proforma_id" not-null="true" />
		<many-to-one name="billableService" class="org.openmrs.module.mohbilling.model.BillableService" column="billable_service_id" />
		<property name="serviceName" column="service_name" type="string" not-null="true" />
		<property name="categoryName" column="category_name" type="string" />
		<property name="unitPrice" column="unit_price" type="big_decimal" not-null="true" />
		<property name="quantity" column="quantity" type="big_decimal" not-null="true" />
		<property name="lineTotal" column="line_total" type="big_decimal" not-null="true" />
		<property name="uuid" column="uuid" type="string" not-null="true" />
	</class>

</hibernate-mapping>
